aiaph:es_EEGNeuralTracking a aiaph:EffectSizeMeasurement ;
    aiaph:accuracyValue "0.854"^^xsd:decimal ; aiaph:sampleSize 48 ; aiaph:chanceLevel "0.50"^^xsd:decimal ;
    aiaph:cohensH "0.787"^^xsd:decimal ; aiaph:standardError "0.144"^^xsd:decimal .

