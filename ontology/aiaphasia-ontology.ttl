aiaph:ca_LLMBCISpeller a aiaph:AssistiveApplication ;
    aiaph:isApplicationOf aiaph:LLMBCISpeller ;
    aiaph:applicationDescription "Proposta concettuale (non ancora un sistema clinicamente validato) di combinare la predizione linguistica degli LLM con la velocità limitata degli speller BCI non invasivi, per accelerare la comunicazione assistita."@it ;
