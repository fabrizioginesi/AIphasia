    aiaph:isApplicationOf aiaph:EEGNeuralTrackingSVM ;
    aiaph:applicationDescription "Rilevamento dell'afasia da misure di neural tracking EEG durante ascolto di parlato continuo, su 26 persone con afasia e 22 controlli."@it ;
    aiaph:addressesModality aiaph:OralComprehension ;
    aiaph:hasEvidenceLevel aiaph:Level4_ExperimentalPrototype ;
