    aiaph:targetsAphasiaType aiaph:AnomicAphasia ;
    aiaph:addressesLinguisticDomain aiaph:SemanticLexicalDomain ;
    aiaph:addressesModality aiaph:OralProduction ;
    aiaph:hasEvidenceLevel aiaph:Level1_SystematicReviewOrRCT ;
    aiaph:reportedMetric "RCT multicentrico, evidenza di Livello I per l'efficacia clinica e la fattibilità (Kiran & Smith, 2025)" ;
    aiaph:hasLimitation aiaph:lim_cactus_1 .
aiaph:lim_cactus_1 a aiaph:ClinicalGovernanceLimitation ;
