aiaph:ca_VNeST a aiaph:TherapeuticApplication ;
    aiaph:isApplicationOf aiaph:ComputerizedVNeST ;
    aiaph:applicationDescription "Rinforzo della rete verbale per il recupero lessicale in frase, erogato via computer/teleriabilitazione; mostra generalizzazione a item non trattati in afasia da moderata a severa."@it ;
    aiaph:targetsAphasiaType aiaph:AnomicAphasia , aiaph:BrocaAphasia , aiaph:ConductionAphasia ;
    aiaph:addressesLinguisticDomain aiaph:SemanticLexicalDomain , aiaph:SyntacticMorphologicalDomain ;
    aiaph:addressesModality aiaph:OralProduction ;
    aiaph:evaluatedByTest aiaph:BostonNamingTest ;
    aiaph:hasEvidenceLevel aiaph:Level3_PilotOrSingleCase ;
