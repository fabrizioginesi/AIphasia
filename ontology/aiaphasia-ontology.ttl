    aiaph:sourceURL <https://pmc.ncbi.nlm.nih.gov/articles/PMC11016805/> ;
    aiaph:employsTechnique aiaph:NaturalLanguageProcessing , aiaph:PredictiveOutcomeModeling ;
    aiaph:toolCategory "Diagnosi/Classificazione"@it .

aiaph:ca_DiscourseAQ a aiaph:DiagnosticApplication ;
    aiaph:isApplicationOf aiaph:DiscourseBasedAQEstimation ;
    aiaph:applicationDescription "I modelli basati sul discorso stimano bene l'AQ e superano quelli basati solo su dati lesionali; l'aggiunta di feature lesionali non migliora sostanzialmente le prestazioni. Utile per monitoraggio remoto in popolazioni con accesso limitato a clinici formati (es. aree rurali)."@it ;
    aiaph:addressesLinguisticDomain aiaph:PragmaticDomain , aiaph:SyntacticMorphologicalDomain ;
    aiaph:addressesModality aiaph:OralProduction ;
    aiaph:hasEvidenceLevel aiaph:Level4_ExperimentalPrototype ;
    aiaph:reportedMetric "n=71 sopravvissuti a ictus con neuroimaging strutturale disponibile (2024)" ;
    aiaph:hasLimitation aiaph:lim_discourseaq_1 .
aiaph:lim_discourseaq_1 a aiaph:GeneralizabilityLimitation ;
    aiaph:limitationNote "Campione di ricerca monocentrico; non ancora integrato in un flusso di lavoro clinico di screening remoto su larga scala."@it .

### 33. BCI P300 per naming e ripetizione ----------------------------------------
aiaph:P300BCIRehabilitation a aiaph:AITool ;
    aiaph:toolName "BCI basata su paradigma visivo P300 per la riabilitazione dell'afasia" ;
    aiaph:developer "Ricerca accademica, rassegna in Proceedings BEFS 2025 (SCITEPRESS)" ;
    aiaph:releaseYear "2025"^^xsd:integer ;
    aiaph:toolDescription "Sistema BCI che sfrutta il paradigma P300 (un potenziale evento-relato EEG) per fornire feedback in tempo reale durante compiti di denominazione e ripetizione di frasi, talvolta integrato con realtà virtuale e stimolazione cerebrale non invasiva."@it ;
    aiaph:sourceURL <https://www.scitepress.org/Papers/2025/142995/142995.pdf> ;
    aiaph:employsTechnique aiaph:EEGNeurofeedbackDecoding ;
    aiaph:toolCategory "BCI/Neuroprotesi"@it .

aiaph:ca_P300BCI a aiaph:TherapeuticApplication ;
