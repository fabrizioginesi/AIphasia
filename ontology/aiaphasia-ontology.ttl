    aiaph:developer "Caria (2025)" ;
    aiaph:releaseYear "2025"^^xsd:integer ;
    aiaph:toolDescription "Articolo di visione/rassegna che propone la fusione tra modelli linguistici di grande scala (LLM) e interfacce cervello-computer non invasive di tipo 'speller', per una comunicazione predittiva assistita in persone con gravi limitazioni comunicative."@it ;
    aiaph:sourceURL <https://www.mdpi.com/1424-8220/25/13/3987> ;
