# EOF

#################################################################
# 13. META-ANALISI STATISTICA: IA COMPORTAMENTALE vs COVERT/CONSCIENTIAL
#################################################################
# Questa sezione formalizza nel grafo la meta-analisi discussa nel documento
# "meta-analysis-direction.md": non è più un calcolo esterno, ma un livello
# di conoscenza interrogabile via SPARQL.

### 13.1 Lo strato di elaborazione (dimensione ortogonale a tecnica/applicazione)

aiaph:ProcessingLayer a owl:Class ;
    rdfs:label "Strato di elaborazione"@it ;
    rdfs:comment "Distingue se uno strumento IA opera sul comportamento linguistico osservabile (output prodotto, per quanto imperfetto) o tenta di accedere al segnale neurale covert durante il linguaggio interiore/immaginato, prima o a prescindere dal canale articolatorio. Dimensione ortogonale rispetto a TherapeuticApplication/DiagnosticApplication/ecc. e a AITechnique."@it .

aiaph:SurfaceBehavioralLayer a aiaph:ProcessingLayer , owl:NamedIndividual ;
    rdfs:label "Strato comportamentale/di superficie"@it ;
    rdfs:comment "Lo strumento classifica, genera o predice a partire da un segnale osservabile: parlato prodotto, testo, punteggio clinico, imaging strutturale/funzionale usato come proxy indiretto."@it .

aiaph:CovertConscientialLayer a aiaph:ProcessingLayer , owl:NamedIndividual ;
    rdfs:label "Strato covert/consciential"@it ;
    rdfs:comment "Lo strumento decodifica direttamente dal segnale neurale acquisito durante un compito di linguaggio interiore/immaginato (inner/imagined speech), tentando di accedere all'evento cosciente linguistico a monte o a prescindere dal canale articolatorio."@it .

aiaph:operatesOnLayer a owl:ObjectProperty ;
    rdfs:domain aiaph:AITool ; rdfs:range aiaph:ProcessingLayer ;
    rdfs:label "opera sullo strato"@it .

### 13.2 Misura di effect size reificata (Cohen's h vs baseline di chance)

aiaph:EffectSizeMeasurement a owl:Class ;
    rdfs:label "Misura di effect size"@it ;
    rdfs:comment "Reifica il calcolo di un effect size standardizzato (Cohen's h) per una singola applicazione clinica, a partire da accuratezza, N e livello di chance dichiarati nella fonte. h = 2·arcsin(√p_osservata) − 2·arcsin(√p_chance); varianza campionaria ≈ 1/N."@it .

aiaph:hasEffectSizeMeasurement a owl:ObjectProperty ;
    rdfs:domain aiaph:ClinicalApplication ; rdfs:range aiaph:EffectSizeMeasurement ;
    rdfs:label "ha misura di effect size"@it .

aiaph:accuracyValue a owl:DatatypeProperty ; rdfs:domain aiaph:EffectSizeMeasurement ; rdfs:range xsd:decimal ;
    rdfs:label "valore di accuratezza"@it .
aiaph:sampleSize a owl:DatatypeProperty ; rdfs:domain aiaph:EffectSizeMeasurement ; rdfs:range xsd:integer ;
    rdfs:label "dimensione campionaria (N)"@it .
aiaph:chanceLevel a owl:DatatypeProperty ; rdfs:domain aiaph:EffectSizeMeasurement ; rdfs:range xsd:decimal ;
    rdfs:label "livello di chance"@it .
aiaph:cohensH a owl:DatatypeProperty ; rdfs:domain aiaph:EffectSizeMeasurement ; rdfs:range xsd:decimal ;
    rdfs:label "Cohen's h"@it .
aiaph:standardError a owl:DatatypeProperty ; rdfs:domain aiaph:EffectSizeMeasurement ; rdfs:range xsd:decimal ;
    rdfs:label "errore standard"@it .
aiaph:chanceLevelAssumption a owl:AnnotationProperty ;
    rdfs:label "assunzione sul livello di chance"@it ;
    rdfs:comment "Usata quando il livello di chance non è dichiarato esplicitamente nella fonte primaria ed è stato stimato; rende l'assunzione tracciabile nel grafo invece che implicita."@it .

### 13.3 Pool meta-analitico (effetti casuali, DerSimonian-Laird) e confronto tra famiglie

aiaph:MetaAnalyticPool a owl:Class ;
    rdfs:label "Pool meta-analitico"@it ;
    rdfs:comment "Il risultato aggregato a effetti casuali (DerSimonian-Laird) per un insieme di EffectSizeMeasurement appartenenti allo stesso ProcessingLayer."@it .

aiaph:aggregatesMeasurement a owl:ObjectProperty ;
    rdfs:domain aiaph:MetaAnalyticPool ; rdfs:range aiaph:EffectSizeMeasurement ;
    rdfs:label "aggrega la misura"@it .
aiaph:pooledH a owl:DatatypeProperty ; rdfs:domain aiaph:MetaAnalyticPool ; rdfs:range xsd:decimal .
aiaph:ciLower a owl:DatatypeProperty ; rdfs:domain aiaph:MetaAnalyticPool ; rdfs:range xsd:decimal .
aiaph:ciUpper a owl:DatatypeProperty ; rdfs:domain aiaph:MetaAnalyticPool ; rdfs:range xsd:decimal .
aiaph:kStudies a owl:DatatypeProperty ; rdfs:domain aiaph:MetaAnalyticPool ; rdfs:range xsd:integer .
aiaph:qStatistic a owl:DatatypeProperty ; rdfs:domain aiaph:MetaAnalyticPool ; rdfs:range xsd:decimal .
aiaph:tau2 a owl:DatatypeProperty ; rdfs:domain aiaph:MetaAnalyticPool ; rdfs:range xsd:decimal .
aiaph:iSquared a owl:DatatypeProperty ; rdfs:domain aiaph:MetaAnalyticPool ; rdfs:range xsd:decimal ;
    rdfs:comment "Percentuale di eterogeneità residua non spiegata dal solo errore campionario."@it .

aiaph:MetaAnalysisComparison a owl:Class ;
    rdfs:label "Confronto meta-analitico tra pool"@it .
aiaph:comparesPool a owl:ObjectProperty ; rdfs:domain aiaph:MetaAnalysisComparison ; rdfs:range aiaph:MetaAnalyticPool .
aiaph:differenceH a owl:DatatypeProperty ; rdfs:domain aiaph:MetaAnalysisComparison ; rdfs:range xsd:decimal .
aiaph:zScore a owl:DatatypeProperty ; rdfs:domain aiaph:MetaAnalysisComparison ; rdfs:range xsd:decimal .
aiaph:pValue a owl:DatatypeProperty ; rdfs:domain aiaph:MetaAnalysisComparison ; rdfs:range xsd:decimal .
aiaph:isStatisticallySignificant a owl:DatatypeProperty ; rdfs:domain aiaph:MetaAnalysisComparison ; rdfs:range xsd:boolean .

# EOF

#################################################################
# 14. I 9 STUDI DELLA META-ANALISI: NUOVI STRUMENTI + MISURE DI EFFECT SIZE
#################################################################

### 34. SONIVA — rilevamento ictus da embedding Whisper -------------------------
aiaph:SONIVAStrokeDetection a aiaph:AITool ;
    aiaph:toolName "SONIVA - rilevamento ictus da embedding Whisper" ;
    aiaph:developer "Ricerca accademica (2025)" ;
    aiaph:releaseYear "2025"^^xsd:integer ;
    aiaph:toolDescription "Classificatore binario ictus/non-ictus basato su embedding vocali estratti da un modello Whisper, su un ampio database di pazienti."@it ;
    aiaph:sourceURL <https://www.researchgate.net/publication/392430279_SONIVA_Speech_recOgNItion_Validation_in_Aphasia> ;
    aiaph:employsTechnique aiaph:AutomaticSpeechRecognition , aiaph:DeepLearningClassifier ;
    aiaph:operatesOnLayer aiaph:SurfaceBehavioralLayer ;
    aiaph:toolCategory "Diagnosi/Classificazione"@it .

aiaph:ca_SONIVA a aiaph:DiagnosticApplication ;
    aiaph:isApplicationOf aiaph:SONIVAStrokeDetection ;
    aiaph:applicationDescription "Rilevamento automatico di ictus (di cui l'afasia è una delle conseguenze più frequenti) da embedding vocali su circa 600 pazienti."@it ;
    aiaph:addressesModality aiaph:OralProduction ;
    aiaph:hasEvidenceLevel aiaph:Level4_ExperimentalPrototype ;
    aiaph:reportedMetric "Accuratezza 93%, N≈600, task binario (chance 50%)" ;
    aiaph:hasEffectSizeMeasurement aiaph:es_SONIVA ;
    aiaph:hasLimitation aiaph:lim_soniva_1 .
aiaph:lim_soniva_1 a aiaph:GeneralizabilityLimitation ;
    aiaph:limitationNote "Rileva l'ictus in generale, non l'afasia specificamente; la composizione esatta del campione (pazienti con vs senza afasia) non è chiara dalla sola fonte secondaria consultata."@it .
aiaph:es_SONIVA a aiaph:EffectSizeMeasurement ;
    aiaph:accuracyValue "0.93"^^xsd:decimal ; aiaph:sampleSize 600 ; aiaph:chanceLevel "0.50"^^xsd:decimal ;
    aiaph:cohensH "1.035"^^xsd:decimal ; aiaph:standardError "0.041"^^xsd:decimal .

### 35. SVM su neural tracking EEG (De Clercq et al. 2024) -----------------------
aiaph:EEGNeuralTrackingSVM a aiaph:AITool ;
    aiaph:toolName "SVM su neural tracking EEG per il rilevamento dell'afasia" ;
    aiaph:developer "De Clercq et al. (2024)" ;
    aiaph:releaseYear "2024"^^xsd:integer ;
    aiaph:toolDescription "Classificatore SVM addestrato su misure di 'neural tracking' del parlato continuo estratte da EEG, per distinguere persone con afasia da controlli sani."@it ;
    aiaph:sourceURL <https://pubmed.ncbi.nlm.nih.gov/40039757/> ;
    aiaph:employsTechnique aiaph:SupportVectorMachineClassifier ;
    aiaph:operatesOnLayer aiaph:SurfaceBehavioralLayer ;
    aiaph:toolCategory "Diagnosi/Classificazione"@it .

