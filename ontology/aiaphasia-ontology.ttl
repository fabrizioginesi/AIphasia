@prefix aiaph:   <https://w3id.org/aiaphasia#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix dul:     <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#> .

dcterms:title a owl:AnnotationProperty .
dcterms:description a owl:AnnotationProperty .
dcterms:created a owl:AnnotationProperty .
dcterms:license a owl:AnnotationProperty .

#################################################################
# 0. ONTOLOGY HEADER
#################################################################

aiaph: a owl:Ontology ;
    dcterms:title "AIAphasia: un'ontologia per gli strumenti di Intelligenza Artificiale nel trattamento clinico dell'afasia"@it ;
    dcterms:title "AIAphasia: an ontology for Artificial Intelligence tools in the clinical treatment of aphasia"@en ;
    dcterms:description "Ontologia OWL che formalizza (i) la tassonomia clinico-linguistica dell'afasia (tipi, domini linguistici, modalità comunicative, sintomi, test diagnostici) e (ii) gli strumenti di Intelligenza Artificiale impiegati nella diagnosi, valutazione e riabilitazione dell'afasia, modellando ogni strumento come una o più applicazioni cliniche reificate, corredate da livello di evidenza scientifica e limiti dichiarati."@it ;
    dcterms:created "2026-09-15"^^xsd:date ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    rdfs:comment "NOTA METODOLOGICA SUL PATTERN DI MODELLAZIONE: il nucleo dell'ontologia (aiaph:ClinicalApplication come reificazione n-aria di un uso di aiaph:AITool) segue il pattern Descriptions & Situations (DnS) dell'upper ontology DOLCE-Ultralite (DUL — Ontology Design Patterns portal). Le classi dul: sono riusate per IRI e dichiarate come stub locali in §1c, senza owl:imports dell'intero file DUL, per restare verificabili con un reasoner offline; l'allineamento è quindi documentale (quali classi 'giocano il ruolo' di quali classi DUL), non un'importazione effettiva dell'assiomatica DUL completa."@it ;
    owl:versionInfo "Progetto universitario: ontologia OWL con allineamento DUL/DnS, property chain inferenziale, domande di competenza positive/negative, vincoli di cardinalità su ClinicalApplication, due classi definite, e una tabella di allineamento esterno verso ICF" .

#################################################################
# 1. CLASSI DI PRIMO LIVELLO
#################################################################

aiaph:AphasiaType a owl:Class ;
    rdfs:label "Tipo di afasia"@it , "Aphasia type"@en ;
    rdfs:comment "Una sindrome afasica, individuata da un profilo di deficit linguistici. L'ontologia distingue due rami per eziologia — aiaph:PostStrokeAphasia (vascolare, classificata secondo il modello neoclassico di Boston basato su fluenza/comprensione/ripetizione) e aiaph:PrimaryProgressiveAphasia (neurodegenerativa, classificata secondo i criteri di consenso internazionale di Gorno-Tempini et al., 2011) — poiché sono nosograficamente distinte pur condividendo il fenotipo di compromissione linguistica."@it ;
    rdfs:comment "NOTA EPISTEMOLOGICA: il modello classificatorio categoriale (neoclassico/locazionista) qui adottato per l'afasia post-ictus è quello clinicamente più diffuso, ma è oggetto di critica consolidata in letteratura: non tutti i profili di pazienti reali rientrano nettamente in una singola categoria (esistono forme 'miste' e casi di confine), il modello tratta il linguaggio come funzione isolata quando è interconnesso con memoria di lavoro, controllo esecutivo e cognizione semantica, e non cattura le alterazioni cognitive concomitanti (es. aprassia). Il modello alternativo cognitivo-neuropsicologico (basato su batterie come la PALPA) scompone il linguaggio in moduli di elaborazione discreti invece che in sindromi categoriali; proposte di riclassificazione alternative sono state avanzate anche entro il modello categoriale stesso (es. Ardila, 2010). Questa ontologia adotta il modello categoriale per la sua diffusione clinica e la sua compatibilità con gli strumenti diagnostici IA mappati nel grafo (quasi tutti addestrati per classificare in categorie discrete), ma tratta tale scelta come una decisione di modellazione dichiarata, non come un fatto clinico privo di alternative."@it ;
    rdfs:seeAlso <https://icd.who.int/browse11/l-m/en#/http%3a%2f%2fid.who.int%2ficd%2fentity%2f1281448132> ;
    aiaph:icd11Code "MA80.0" ;
    aiaph:icd10cmCode "R47.01" ;
    aiaph:standardsAlignmentNote "ICD-11 (MA80.0) e ICD-10-CM (R47.01) codificano 'afasia' a livello generale, senza codici distinti per i sottotipi clinici (Broca, Wernicke, ecc.); la sotto-tipizzazione richiede la post-coordinazione con codici di estensione (ICD-11) o rimane extra-nosologica, demandata alla documentazione clinica testuale. Questo è uno dei motivi per cui un'ontologia OWL dedicata, più granulare degli standard di codifica sanitaria, ha valore descrittivo autonomo."@it .

aiaph:LinguisticDomain a owl:Class ;
    rdfs:label "Dominio linguistico"@it ;
    rdfs:comment "Uno dei livelli di struttura della competenza linguistica che può essere selettivamente compromesso nell'afasia (fonologico, semantico-lessicale, sintattico-morfologico, pragmatico)."@it .

aiaph:CommunicationModality a owl:Class ;
    rdfs:label "Modalità comunicativa"@it ;
    rdfs:comment "Uno dei quattro canali di comunicazione che l'afasia può colpire: produzione orale, comprensione orale, produzione scritta, comprensione scritta."@it .

aiaph:ExtraLinguisticDomain a owl:Class ;
    rdfs:label "Dominio extra-linguistico"@it ;
    rdfs:comment "Un'abilità non strettamente linguistica ma frequentemente compromessa come effetto a catena dell'afasia (es. calcolo, sfera psicosociale)."@it .

aiaph:ClinicalSymptom a owl:Class ;
    rdfs:label "Sintomo clinico"@it ;
    rdfs:comment "Una manifestazione osservabile del disturbo afasico, riconducibile a uno specifico dominio linguistico."@it .

aiaph:DiagnosticTest a owl:Class ;
    rdfs:label "Test diagnostico"@it ;
    rdfs:comment "Uno strumento standardizzato, somministrato da un clinico o neuropsicologo, per identificare e quantificare il deficit afasico."@it .

aiaph:AITool a owl:Class ;
    rdfs:label "Strumento di Intelligenza Artificiale"@it , "AI tool"@en ;
    rdfs:comment "Un software, sistema, dispositivo o agente che impiega tecniche di Intelligenza Artificiale (machine learning, NLP, ASR, modelli generativi, ecc.) in un contesto clinico legato all'afasia: l'entità 'opera' che viene poi analizzata attraverso una o più applicazioni cliniche."@it .

aiaph:ClinicalApplication a owl:Class ;
    rdfs:label "Applicazione clinica"@it ;
    rdfs:comment "Il pattern di modellazione centrale dell'ontologia: la reificazione di un uso specifico di un AITool su una popolazione/dominio target, con un proprio livello di evidenza e propri limiti dichiarati. Un singolo AITool può generare più ClinicalApplication (ad es. una per la diagnosi, una per la terapia)."@it .

aiaph:TherapeuticApplication a owl:Class ; rdfs:subClassOf aiaph:ClinicalApplication ;
    rdfs:label "Applicazione terapeutica"@it ;
    rdfs:comment "Lo strumento è impiegato per trattare/riabilitare una funzione linguistica compromessa."@it .
aiaph:DiagnosticApplication a owl:Class ; rdfs:subClassOf aiaph:ClinicalApplication ;
    rdfs:label "Applicazione diagnostica"@it ;
    rdfs:comment "Lo strumento è impiegato per rilevare, classificare o descrivere il disturbo afasico o le sue sottotipologie."@it .
aiaph:PrognosticApplication a owl:Class ; rdfs:subClassOf aiaph:ClinicalApplication ;
    rdfs:label "Applicazione prognostica"@it ;
    rdfs:comment "Lo strumento predice l'esito futuro (recupero, gravità residua) a partire da dati acuti o precoci, senza intervenire direttamente sul trattamento."@it .
aiaph:AssistiveApplication a owl:Class ; rdfs:subClassOf aiaph:ClinicalApplication ;
    rdfs:label "Applicazione assistiva"@it ;
    rdfs:comment "Lo strumento sostituisce o aumenta la comunicazione residua del paziente (AAC, neuroprotesi) senza necessariamente mirare al recupero della funzione linguistica."@it .

[] a owl:AllDisjointClasses ;
   owl:members ( aiaph:TherapeuticApplication aiaph:DiagnosticApplication
                 aiaph:PrognosticApplication aiaph:AssistiveApplication ) .

#################################################################
# 1d. VINCOLI DI INTEGRITA' SU ClinicalApplication
#
# Fino a qui ogni ClinicalApplication è stata disciplinata solo da
# restrizioni di dominio/codominio (quali proprietà PUO' avere), non da
# cardinalità (quante ne DEVE avere). Senza un vincolo esplicito, un'istanza
# priva di livello di evidenza o con due strumenti sorgente diversi sarebbe
# comunque consistente per il reasoner: non un errore di dati, solo un fatto
# non vincolato. Le tre restrizioni sotto chiudono questo spazio e sono state
# verificate per via SPARQL contro le 40 istanze reali prima di essere
# asserite come vincoli (nessuna viola exactly-1 su isApplicationOf o
# hasEvidenceLevel, nessuna ha hasLimitation vuoto), cosicché il vincolo
# descriva un invariante già rispettato dal grafo, non un'aspirazione.
#################################################################

aiaph:isApplicationOf a owl:FunctionalProperty .
aiaph:hasEvidenceLevel a owl:FunctionalProperty .

aiaph:ClinicalApplication rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty aiaph:isApplicationOf ;
      owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; owl:onClass aiaph:AITool ] ,
    [ a owl:Restriction ; owl:onProperty aiaph:hasEvidenceLevel ;
      owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; owl:onClass aiaph:EvidenceLevel ] ,
    [ a owl:Restriction ; owl:onProperty aiaph:hasLimitation ;
      owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ; owl:onClass aiaph:Limitation ] .

#################################################################
# 1e. SECONDA CLASSE DEFINITA: evidenza clinica alta, via disgiunzione di
# valori. A differenza di UndifferentiatedByAphasiaSubtype (definita da
# un'assenza, §1b), questa è definita da un valore esplicito tra due
# possibili (owl:unionOf di due owl:hasValue), per mostrare che il pattern
# "classe definita" non è un trucco isolato ma una tecnica di modellazione
# riusabile con forme logiche diverse.
#################################################################

aiaph:HighEvidenceApplication a owl:Class ;
    owl:equivalentClass [
        a owl:Class ;
        owl:intersectionOf (
            aiaph:ClinicalApplication
            [ a owl:Class ;
              owl:unionOf (
                [ a owl:Restriction ; owl:onProperty aiaph:hasEvidenceLevel ; owl:hasValue aiaph:Level1_SystematicReviewOrRCT ]
                [ a owl:Restriction ; owl:onProperty aiaph:hasEvidenceLevel ; owl:hasValue aiaph:Level2_ControlledTrial ]
              )
            ]
        )
    ] ;
    rdfs:label "Applicazione con evidenza clinica alta"@it ;
    rdfs:comment "Classe DEFINITA: raccoglie, tramite l'unione di due restrizioni di valore (owl:hasValue), ogni ClinicalApplication il cui hasEvidenceLevel è Livello 1 o Livello 2 — cioè supportata da almeno un trial controllato, non solo da un prototipo o da un caso singolo. Permette di contare quante delle 40 applicazioni poggiano su evidenza robusta senza dover enumerare manualmente le due categorie ogni volta."@it .

aiaph:AITechnique a owl:Class ;
    rdfs:label "Tecnica di IA"@it ;
    rdfs:comment "La tecnica computazionale sottostante impiegata da un AITool (es. riconoscimento automatico del parlato, modello linguistico di grande scala, classificatore supervisionato)."@it .

aiaph:EvidenceLevel a owl:Class ;
    rdfs:label "Livello di evidenza"@it ;
    rdfs:comment "Una scala a cinque punti che qualifica la robustezza scientifica di una ClinicalApplication, dal prototipo sperimentale alla revisione sistematica/RCT multicentrico."@it .

aiaph:Limitation a owl:Class ;
    rdfs:label "Limite"@it ;
    rdfs:comment "Un limite dichiarato e documentato di una ClinicalApplication. Le sottoclassi ortogonali modellano diverse *nature* del limite (dati, governance clinica, generalizzabilità, validità di costrutto, accessibilità, confine nosografico), per trattare lo scarto come dato analitico e non come rumore."@it .

#################################################################
# 1c. ALLINEAMENTO A DOLCE-ULTRALITE (DUL): PATTERN DESCRIPTIONS & SITUATIONS
# Le classi dul: sotto sono stub locali (stesso IRI dell'ontologia DUL
# pubblica sul portale Ontology Design Patterns, non importata per intero)
# usati per dichiarare esplicitamente a quale "ruolo" ontologico di livello
# superiore corrisponde ciascuna classe di primo livello di AIphasia. Questo
# rende interrogabile anche a chi non conosce il dominio clinico la *forma*
# logica delle relazioni (una Situazione che soddisfa una Descrizione),
# indipendentemente dal contenuto specifico dell'afasia.
#################################################################

dul:Situation a owl:Class ;
    rdfs:label "Situation (DUL, esterna)"@en ;
    rdfs:comment "Stub locale di dul:Situation. Una configurazione di entità che soddisfa (satisfies) una dul:Description. Qui gioca questo ruolo aiaph:ClinicalApplication: l'uso specifico di uno strumento su un target clinico è la 'situazione' che rende vera una descrizione clinica/metodologica."@en .
dul:Description a owl:Class ;
    rdfs:label "Description (DUL, esterna)"@en ;
    rdfs:comment "Stub locale di dul:Description. Uno schema non-fisico (norma, piano, teoria, protocollo) che una Situation può soddisfare. Nessuna classe di AIphasia è dichiarata equivalente a questa radice: il protocollo clinico/di validazione implicito in ogni ClinicalApplication resta extra-ontologico, citato nelle fonti bibliografiche (aiaph:sourceURL) piuttosto che formalizzato triade per triade."@en .
dul:Object a owl:Class ;
    rdfs:label "Object (DUL, esterna)"@en ;
    rdfs:comment "Stub locale di dul:Object (endurant). Qui gioca questo ruolo aiaph:AITool: un'entità persistente nel tempo che partecipa a una o più Situation (ClinicalApplication) senza esaurirsi in nessuna di esse — lo stesso strumento può generare più applicazioni cliniche."@en .
dul:Concept a owl:Class ;
    rdfs:label "Concept (DUL, esterna)"@en ;
    rdfs:comment "Stub locale di dul:Concept, una categoria socialmente/clinicamente costruita usata per classificare. Qui gioca questo ruolo aiaph:AphasiaType: la sindrome non è un oggetto fisico ma la categoria diagnostica, eziologicamente ramificata (post-ictus / PPA), sotto cui un paziente viene classificato."@en .
dul:Parameter a owl:Class ;
    rdfs:label "Parameter (DUL, esterna)"@en ;
    rdfs:comment "Stub locale di dul:Parameter, una dimensione di variabilità di una Situation. Qui gioca questo ruolo aiaph:EvidenceLevel: non è una proprietà intrinseca dello strumento, ma un parametro di quanto robustamente la specifica ClinicalApplication è stata validata."@en .
dul:Quality a owl:Class ;
    rdfs:label "Quality (DUL, esterna)"@en ;
    rdfs:comment "Stub locale di dul:Quality, un aspetto osservabile/misurabile inerente a un'entità. Qui gioca questo ruolo aiaph:Limitation: ogni sottoclasse ortogonale di Limitation è trattata come qualità costitutiva della ClinicalApplication (un dato analitico da interrogare), non come rumore o eccezione da scartare."@en .

aiaph:ClinicalApplication rdfs:subClassOf dul:Situation .
aiaph:AITool rdfs:subClassOf dul:Object .
aiaph:AphasiaType rdfs:subClassOf dul:Concept .
aiaph:EvidenceLevel rdfs:subClassOf dul:Parameter .
aiaph:Limitation rdfs:subClassOf dul:Quality .

#################################################################
# 1b. CLASSE DEFINITA (non asserita): la lacuna di differenziazione per
# sottotipo di afasia. Non la annotiamo manualmente strumento per strumento:
# la definiamo tramite una restrizione OWL sulla cardinalità di
# targetsAphasiaType, cosicché sia il *reasoner*, non un'annotazione umana, a
# classificare automaticamente ogni ClinicalApplication che tratta "l'afasia"
# come categoria indifferenziata. È il fulcro formale dell'obiettivo del
# progetto: rendere interrogabile e quantificabile, non solo osservabile per
# assenza, la principale lacuna metodologica del campo.
#################################################################
aiaph:UndifferentiatedByAphasiaSubtype a owl:Class ;
    owl:equivalentClass [
        a owl:Class ;
        owl:intersectionOf (
            aiaph:ClinicalApplication
            [ a owl:Restriction ; owl:onProperty aiaph:targetsAphasiaType ; owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ; owl:onClass aiaph:AphasiaType ]
        )
    ] ;
    rdfs:label "Applicazione non differenziata per sottotipo di afasia"@it ;
    rdfs:comment "Classe DEFINITA tramite restrizione di cardinalità qualificata, non tramite annotazione manuale: il criterio di appartenenza è quindi formale e univoco, non una categoria a cui si assegna un'istanza per giudizio soggettivo. Sotto la semantica open-world di OWL DL, HermiT non puo' pero' classificare un'istanza qui per sola assenza di una tripla targetsAphasiaType (l'assenza di un'asserzione non prova una cardinalità massima: potrebbe esistere un filler non ancora dichiarato). L'ontologia tratta quindi il catalogo delle 40 ClinicalApplication come deliberatamente chiuso a fini analitici — e' un elenco curato e completo delle fonti reperite, non un campione parziale — e opera questa stessa definizione come query SPARQL a mondo chiuso (FILTER NOT EXISTS, sparql/cq5_undifferentiated_applications.rq), equivalente estensionale della classe DL quando il grafo e' trattato come completo. Nell'analisi empirica cosi' condotta, 27 applicazioni su 40 (67,5%) ricadono in questa classe — la maggioranza — un disallineamento rispetto alla pratica clinica, dove il sottotipo guida la scelta terapeutica (si veda il materiale clinico all'origine di questo progetto)."@it .

aiaph:DifferentiatedByAphasiaSubtype a owl:Class ;
    owl:equivalentClass [
        a owl:Class ;
        owl:intersectionOf ( aiaph:ClinicalApplication [ owl:complementOf aiaph:UndifferentiatedByAphasiaSubtype ] )
    ] ;
    rdfs:label "Applicazione differenziata per sottotipo di afasia"@it ;
    rdfs:comment "Complemento (ristretto a ClinicalApplication) della classe precedente, per comodità di interrogazione: le ClinicalApplication che dichiarano esplicitamente almeno un sottotipo target."@it .

#################################################################
# 2. SOTTOCLASSI: TIPI DI AFASIA (da fonte clinica fornita + MSD Manual)
#################################################################

aiaph:PostStrokeAphasia a owl:Class ;
    rdfs:subClassOf aiaph:AphasiaType ;
    rdfs:label "Afasia post-ictus (vascolare)"@it ;
    rdfs:comment "Afasia ad esordio acuto/improvviso, di eziologia vascolare (ictus ischemico o emorragico) o comunque lesionale acuta (trauma cranico). Classificata secondo il modello neoclassico di Boston (Goodglass & Kaplan) in base a fluenza, comprensione e ripetizione. È il ramo eziologico coperto dalla maggior parte degli strumenti diagnostici e terapeutici del grafo (es. Big CACTUS, Constant Therapy, classificatori ASR-SVM)."@it .

aiaph:PrimaryProgressiveAphasia a owl:Class ;
    rdfs:subClassOf aiaph:AphasiaType ;
    rdfs:label "Afasia progressiva primaria (PPA)"@it ;
    rdfs:comment "Sindrome neurodegenerativa in cui il deterioramento del linguaggio è il disturbo predominante e isolato all'esordio (a differenza della demenza di Alzheimer tipica, dove il deficit di memoria domina). Classificata secondo i criteri di consenso internazionale di Gorno-Tempini et al. (2011, Neurology) in tre varianti canoniche più una categoria di casi atipici/non classificabili emersa da letteratura successiva (Neurology, 2024). Associata a diverse patologie sottostanti dello spettro della degenerazione lobare frontotemporale e, soprattutto nella variante logopenica, alla malattia di Alzheimer."@it .

aiaph:NonFluentAphasia a owl:Class ;
    rdfs:subClassOf aiaph:PostStrokeAphasia ;
    rdfs:label "Afasia non fluente"@it ;
    rdfs:comment "Eloquio stentato, lento, faticoso, con ridotta produzione di parole al minuto; lesione tipicamente frontale/frontoparietale sinistra."@it .

aiaph:FluentAphasia a owl:Class ;
    rdfs:subClassOf aiaph:PostStrokeAphasia ;
    rdfs:label "Afasia fluente"@it ;
    rdfs:comment "Eloquio scorrevole o iper-fluente ma spesso privo di significato logico, con parafasie e neologismi; lesione tipicamente temporale/temporoparietale sinistra."@it .

aiaph:BrocaAphasia a owl:Class ;
    rdfs:subClassOf aiaph:NonFluentAphasia ;
    rdfs:label "Afasia di Broca"@it ;
    rdfs:comment "Difficoltà marcata nella produzione verbale e nella grammatica, articolazione compromessa, comprensione generalmente integra. Lesione nell'area di Broca, lobo frontale sinistro. Frequenti agrafia e compromissione della lettura ad alta voce."@it .

aiaph:TranscorticalMotorAphasia a owl:Class ;
    rdfs:subClassOf aiaph:NonFluentAphasia ;
    rdfs:label "Afasia transcorticale motoria"@it ;
    rdfs:comment "Simile all'afasia di Broca per la scarsa fluenza, ma con capacità di ripetizione conservata."@it .

aiaph:GlobalAphasia a owl:Class ;
    rdfs:subClassOf aiaph:NonFluentAphasia , aiaph:FluentAphasia ;
    rdfs:label "Afasia globale"@it ;
    rdfs:comment "La forma più grave: compromissione totale o profonda sia della produzione sia della comprensione del linguaggio."@it .

aiaph:MixedTranscorticalAphasia a owl:Class ;
    rdfs:subClassOf aiaph:NonFluentAphasia ;
    rdfs:label "Afasia transcorticale mista (da isolamento)"@it ;
    rdfs:comment "L'ottavo sottotipo del modello neoclassico di Boston, spesso omesso nelle trattazioni sintetiche. Simile all'afasia globale per la grave compromissione di produzione e comprensione, ma con la ripetizione paradossalmente conservata o addirittura ecolalica (il paziente ripete ciò che sente senza comprenderlo). Deriva da lesioni che 'isolano' l'area perisilviana del linguaggio (Broca-Wernicke-fascicolo arcuato, tipicamente risparmiate) dal resto della corteccia, da cui il nome alternativo 'sindrome da isolamento'."@it .

aiaph:WernickeAphasia a owl:Class ;
    rdfs:subClassOf aiaph:FluentAphasia ;
    rdfs:label "Afasia di Wernicke"@it ;
    rdfs:comment "Grave deficit di comprensione del linguaggio parlato e scritto; eloquio fluente ma con contenuto incomprensibile o confuso (parafasie, neologismi). Lesione nella parte posteriore del lobo temporale sinistro (area di Wernicke). Frequente associazione con alessia."@it .

aiaph:ConductionAphasia a owl:Class ;
    rdfs:subClassOf aiaph:FluentAphasia ;
    rdfs:label "Afasia di conduzione"@it ;
    rdfs:comment "Eloquio fluente e buona comprensione, ma deficit grave nella ripetizione di parole o frasi."@it .

aiaph:TranscorticalSensoryAphasia a owl:Class ;
    rdfs:subClassOf aiaph:FluentAphasia ;
    rdfs:label "Afasia transcorticale sensoriale"@it ;
    rdfs:comment "Simile all'afasia di Wernicke per i problemi di comprensione e il linguaggio fluente, ma con ripetizione intatta."@it .

aiaph:AnomicAphasia a owl:Class ;
    rdfs:subClassOf aiaph:FluentAphasia ;
    rdfs:label "Afasia anomica (amnestica)"@it ;
    rdfs:comment "Forma più lieve: il disturbo principale è l'anomia, la difficoltà persistente a trovare i nomi corretti, a fronte di fluenza e comprensione quasi normali."@it .

# Nota: GlobalAphasia è intenzionalmente sotto-classe sia di NonFluent che di Fluent
# (compromissione di entrambi i poli), quindi le classi disgiunte riguardano solo
# le sindromi "pure" non-globali, per evitare inconsistenza logica.
[] a owl:AllDisjointClasses ;
   owl:members ( aiaph:BrocaAphasia aiaph:TranscorticalMotorAphasia aiaph:WernickeAphasia
                 aiaph:ConductionAphasia aiaph:TranscorticalSensoryAphasia aiaph:AnomicAphasia
                 aiaph:MixedTranscorticalAphasia ) .

#################################################################
# 2b. AFASIA PROGRESSIVA PRIMARIA: le tre varianti canoniche (Gorno-Tempini et al.,
# 2011, Neurology 76:1006-1014) più una categoria per i casi che non soddisfano
# nettamente i criteri di nessuna delle tre (Utianski et al./Botha et al., Neurology
# 2024, sul sottogruppo "PPA lacking core features of nonfluent and semantic
# variants": pattern pure-lvPPA, Wernicke-like, anomic-like, TCSA-like).
#################################################################

aiaph:SemanticVariantPPA a owl:Class ;
    rdfs:subClassOf aiaph:PrimaryProgressiveAphasia ;
    rdfs:label "Variante semantica (svPPA)"@it ;
    rdfs:comment "Perdita progressiva della conoscenza semantica (significato di parole, oggetti, persone), con eloquio fluente ma vuoto di contenuto e anomia severa; comprensione di parole singole compromessa. Associata tipicamente ad atrofia del lobo temporale anteriore, prevalentemente sinistro. Nota anche come 'demenza semantica'."@it .

aiaph:NonfluentAgrammaticVariantPPA a owl:Class ;
    rdfs:subClassOf aiaph:PrimaryProgressiveAphasia ;
    rdfs:label "Variante non-fluente/agrammatica (nfvPPA)"@it ;
    rdfs:comment "Eloquio faticoso, agrammatico, con errori di programmazione motoria dell'articolazione (aprassia del linguaggio); comprensione di frasi sintatticamente complesse compromessa, comprensione di singole parole relativamente preservata. Associata tipicamente ad atrofia fronto-insulare sinistra."@it .

aiaph:LogopenicVariantPPA a owl:Class ;
    rdfs:subClassOf aiaph:PrimaryProgressiveAphasia ;
    rdfs:label "Variante logopenica (lvPPA)"@it ;
    rdfs:comment "Eloquio rallentato da frequenti pause per ricerca della parola (anomia), con deficit di ripetizione di frasi e parafasie fonologiche; grammatica e comprensione di parole singole relativamente preservate. Associata tipicamente ad atrofia temporo-parietale sinistra e, a livello patologico, è la variante di PPA più frequentemente legata alla malattia di Alzheimer sottostante piuttosto che alla degenerazione lobare frontotemporale."@it .

aiaph:AtypicalOrUnclassifiedPPA a owl:Class ;
    rdfs:subClassOf aiaph:PrimaryProgressiveAphasia ;
    rdfs:label "PPA atipica o non classificabile"@it ;
    rdfs:comment "Categoria per i casi che non soddisfano nettamente i criteri di consenso 2011 per nessuna delle tre varianti canoniche. La letteratura più recente (Neurology, 2024) propone quattro sotto-pattern su base di ripetizione/comprensione: pure-lvPPA (ripetizione scarsa, comprensione accettabile), Wernicke-like (entrambe scarse), anomic-like (entrambe accettabili), TCSA-like (ripetizione accettabile, comprensione scarsa) — nomi scelti per analogia con le sindromi post-ictus corrispondenti, pur trattandosi di un'eziologia neurodegenerativa e non vascolare. Include anche i casi con profilo 'misto' semantico-logopenico descritti da Mazzeo et al. (2024)."@it .

[] a owl:AllDisjointClasses ;
   owl:members ( aiaph:SemanticVariantPPA aiaph:NonfluentAgrammaticVariantPPA
                 aiaph:LogopenicVariantPPA aiaph:AtypicalOrUnclassifiedPPA ) .

#################################################################
# 2c. PUNNING ESPLICITO: le sindromi foglia (post-ictus + PPA) sono sia Classi
#     (gerarchia clinica) sia Individui nominati (usate come valori di
#     targetsAphasiaType). OWL2 DL lo consente; lo rendiamo esplicito per
#     chiarezza e per buona pratica.
#################################################################
aiaph:BrocaAphasia a owl:NamedIndividual .
aiaph:TranscorticalMotorAphasia a owl:NamedIndividual .
aiaph:GlobalAphasia a owl:NamedIndividual .
aiaph:MixedTranscorticalAphasia a owl:NamedIndividual .
aiaph:WernickeAphasia a owl:NamedIndividual .
aiaph:ConductionAphasia a owl:NamedIndividual .
aiaph:TranscorticalSensoryAphasia a owl:NamedIndividual .
aiaph:AnomicAphasia a owl:NamedIndividual .
aiaph:SemanticVariantPPA a owl:NamedIndividual .
aiaph:NonfluentAgrammaticVariantPPA a owl:NamedIndividual .
aiaph:LogopenicVariantPPA a owl:NamedIndividual .
aiaph:AtypicalOrUnclassifiedPPA a owl:NamedIndividual .

#################################################################
# 3. DOMINI LINGUISTICI, MODALITA', DOMINI EXTRA-LINGUISTICI
#################################################################

aiaph:PhonologicalDomain a owl:Class ; rdfs:subClassOf aiaph:LinguisticDomain ;
    rdfs:label "Dominio fonologico"@it ;
    rdfs:comment "Riguarda i suoni delle parole: scambio/confusione di suoni, inversione di sillabe."@it .

aiaph:SemanticLexicalDomain a owl:Class ; rdfs:subClassOf aiaph:LinguisticDomain ;
    rdfs:label "Dominio semantico-lessicale"@it ;
    rdfs:comment "Riguarda il significato e la scelta delle parole: anomia, sostituzione di vocaboli."@it .

aiaph:SyntacticMorphologicalDomain a owl:Class ; rdfs:subClassOf aiaph:LinguisticDomain ;
    rdfs:label "Dominio sintattico-morfologico"@it ;
    rdfs:comment "Riguarda le regole grammaticali e la costruzione delle frasi: agrammatismo, paragrammatismo."@it .

aiaph:PragmaticDomain a owl:Class ; rdfs:subClassOf aiaph:LinguisticDomain ;
    rdfs:label "Dominio pragmatico"@it ;
    rdfs:comment "Riguarda l'uso del linguaggio nel contesto sociale: turni di parola, sottintesi, ironia."@it .

aiaph:OralProduction a owl:Class ; rdfs:subClassOf aiaph:CommunicationModality ;
    rdfs:label "Produzione orale"@it ;
    aiaph:icfCode "b1671" ; aiaph:icfLabel "Funzioni di espressione del linguaggio (ICF, componente Funzioni corporee)"@it .
aiaph:OralComprehension a owl:Class ; rdfs:subClassOf aiaph:CommunicationModality ;
    rdfs:label "Comprensione orale"@it ;
    aiaph:icfCode "b1670" ; aiaph:icfLabel "Funzioni di ricezione del linguaggio (ICF, componente Funzioni corporee)"@it .
aiaph:WrittenProduction a owl:Class ; rdfs:subClassOf aiaph:CommunicationModality ;
    rdfs:label "Produzione scritta (Agrafia)"@it ;
    aiaph:icfCode "d345" ; aiaph:icfLabel "Scrivere messaggi (ICF, componente Attività e partecipazione)"@it .
aiaph:WrittenComprehension a owl:Class ; rdfs:subClassOf aiaph:CommunicationModality ;
    rdfs:label "Comprensione scritta (Alessia)"@it ;
    aiaph:icfCode "d325" ; aiaph:icfLabel "Ricevere messaggi scritti (ICF, componente Attività e partecipazione)"@it .

aiaph:Acalculia a owl:Class ; rdfs:subClassOf aiaph:ExtraLinguisticDomain ;
    rdfs:label "Acalculia"@it ;
    rdfs:comment "Difficoltà a fare calcoli mentali, riconoscere i numeri, gestire il denaro."@it ;
    aiaph:icfCode "b172" ; aiaph:icfLabel "Funzioni di calcolo (ICF, componente Funzioni corporee)"@it .
aiaph:PsychosocialImpact a owl:Class ; rdfs:subClassOf aiaph:ExtraLinguisticDomain ;
    rdfs:label "Impatto psicosociale"@it ;
    rdfs:comment "Isolamento, frustrazione, alterazioni del tono dell'umore legate alla perdita dei ruoli familiari/lavorativi."@it ;
    aiaph:icfCode "d7" ; aiaph:icfLabel "Interazioni e relazioni interpersonali (ICF, componente Attività e partecipazione)"@it .

aiaph:associatedExtraLinguisticDomain a owl:ObjectProperty ;
    rdfs:domain aiaph:AphasiaType ; rdfs:range aiaph:ExtraLinguisticDomain ;
    rdfs:label "ha dominio extra-linguistico associato"@it ;
    rdfs:comment "Collega AphasiaType a ExtraLinguisticDomain, finora privo di qualsiasi tripla entrante: senza questa proprietà Acalculia e PsychosocialImpact restavano due nodi isolati nel grafo, raggiungibili solo tramite rdfs:subClassOf. Asserita identicamente su tutte e 12 le sindromi foglia (già punnate come individui in §2c/§2b), non su aiaph:AphasiaType come classe, perché il dominio richiede un'istanza e perché la fonte clinica originaria (materiale di origine del progetto) descrive questi effetti a catena come concomitanti generali dell'afasia, senza differenziarli per sindrome: l'identica asserzione su tutte e 12 rende visibile questa non-differenziazione invece di nasconderla dietro un'asserzione a livello di classe."@it .

aiaph:BrocaAphasia aiaph:associatedExtraLinguisticDomain aiaph:Acalculia , aiaph:PsychosocialImpact .
aiaph:TranscorticalMotorAphasia aiaph:associatedExtraLinguisticDomain aiaph:Acalculia , aiaph:PsychosocialImpact .
aiaph:GlobalAphasia aiaph:associatedExtraLinguisticDomain aiaph:Acalculia , aiaph:PsychosocialImpact .
aiaph:MixedTranscorticalAphasia aiaph:associatedExtraLinguisticDomain aiaph:Acalculia , aiaph:PsychosocialImpact .
aiaph:WernickeAphasia aiaph:associatedExtraLinguisticDomain aiaph:Acalculia , aiaph:PsychosocialImpact .
aiaph:ConductionAphasia aiaph:associatedExtraLinguisticDomain aiaph:Acalculia , aiaph:PsychosocialImpact .
aiaph:TranscorticalSensoryAphasia aiaph:associatedExtraLinguisticDomain aiaph:Acalculia , aiaph:PsychosocialImpact .
aiaph:AnomicAphasia aiaph:associatedExtraLinguisticDomain aiaph:Acalculia , aiaph:PsychosocialImpact .
aiaph:SemanticVariantPPA aiaph:associatedExtraLinguisticDomain aiaph:Acalculia , aiaph:PsychosocialImpact .
aiaph:NonfluentAgrammaticVariantPPA aiaph:associatedExtraLinguisticDomain aiaph:Acalculia , aiaph:PsychosocialImpact .
aiaph:LogopenicVariantPPA aiaph:associatedExtraLinguisticDomain aiaph:Acalculia , aiaph:PsychosocialImpact .
aiaph:AtypicalOrUnclassifiedPPA aiaph:associatedExtraLinguisticDomain aiaph:Acalculia , aiaph:PsychosocialImpact .

#################################################################
# 3b. ALLINEAMENTO ESTERNO (ICF) — TABELLA DI CORRISPONDENZA
#
# Finora l'unico ancoraggio a una classificazione esterna erano i codici
# ICD-11/ICD-10-CM sulla sola classe aiaph:AphasiaType (§1), a livello di
# sindrome. Qui l'allineamento scende a livello di singolo dominio/modalità,
# verso la classificazione ICF (International Classification of
# Functioning, Disability and Health) dell'OMS, tramite una tabella di
# corrispondenza esplicita tra le classi locali e i codici ICF esterni.
# aiaph:icfCode/aiaph:icfLabel sopra sono le singole celle della tabella;
# qui sotto la tabella stessa, in forma testuale compatta, con la stessa
# cautela epistemica già usata per ICD-11/ICD-10-CM in §1 (standardsAlignmentNote):
# un allineamento dichiarato e verificabile, non un'importazione dell'ICF.
#################################################################

aiaph:icfCode a owl:AnnotationProperty ; rdfs:label "codice ICF"@it .
aiaph:icfLabel a owl:AnnotationProperty ; rdfs:label "etichetta ICF"@it .
aiaph:icfAlignmentTable a owl:AnnotationProperty ; rdfs:label "tabella di allineamento ICF"@it .

aiaph: aiaph:icfAlignmentTable
    "TABELLA DI CORRISPONDENZA AIAphasia ⊇ ICF — ogni riga 'classe AIAphasia -> codice ICF' è anche asserita come coppia icfCode/icfLabel sulla classe stessa, qui raccolta in un unico punto per leggibilità: OralComprehension->b1670 (Funzioni di ricezione del linguaggio); OralProduction->b1671 (Funzioni di espressione del linguaggio); WrittenComprehension->d325 (Ricevere messaggi scritti); WrittenProduction->d345 (Scrivere messaggi); Acalculia->b172 (Funzioni di calcolo); PsychosocialImpact->d7 (Interazioni e relazioni interpersonali). Nota di cautela: l'ICF descrive funzionamento e disabilità in generale, non è specifico per l'afasia (a differenza di ICD-11/ICD-10-CM già usati in §1 per aiaph:AphasiaType), quindi questo allineamento è utile per situare AIAphasia rispetto a un framework internazionale più ampio, non per sostituire la tassonomia clinica propria dell'ontologia."@it .

#################################################################
# 4. SINTOMI CLINICI
#################################################################

aiaph:Paraphasia a owl:Class ; rdfs:subClassOf aiaph:ClinicalSymptom ;
    rdfs:label "Parafasia"@it ; rdfs:comment "Sostituzione di suoni o parole."@it .
aiaph:Neologism a owl:Class ; rdfs:subClassOf aiaph:ClinicalSymptom ;
    rdfs:label "Neologismo"@it .
aiaph:Agrammatism a owl:Class ; rdfs:subClassOf aiaph:ClinicalSymptom ;
    rdfs:label "Agrammatismo"@it ; rdfs:comment "Eloquio 'telegrafico': eliminazione di verbi coniugati, articoli, preposizioni."@it .
aiaph:Paragrammatism a owl:Class ; rdfs:subClassOf aiaph:ClinicalSymptom ;
    rdfs:label "Paragrammatismo"@it ; rdfs:comment "Frasi lunghe e fluide ma strutturate male e senza senso."@it .
aiaph:Anomia a owl:Class ; rdfs:subClassOf aiaph:ClinicalSymptom ;
    rdfs:label "Anomia"@it ; rdfs:comment "Difficoltà a trovare la parola giusta pur sapendo cosa si vuole dire."@it .
aiaph:Circumlocution a owl:Class ; rdfs:subClassOf aiaph:ClinicalSymptom ;
    rdfs:label "Circonlocuzione"@it .
aiaph:Alexia a owl:Class ; rdfs:subClassOf aiaph:ClinicalSymptom ;
    rdfs:label "Alessia (dislessia acquisita)"@it .
aiaph:Agraphia a owl:Class ; rdfs:subClassOf aiaph:ClinicalSymptom ;
    rdfs:label "Agrafia"@it .

aiaph:manifestsSymptom a owl:ObjectProperty ;
    rdfs:domain aiaph:AphasiaType ; rdfs:range aiaph:ClinicalSymptom ;
    rdfs:label "manifesta sintomo"@it .

aiaph:affectsDomain a owl:ObjectProperty ;
    rdfs:domain aiaph:ClinicalSymptom ; rdfs:range aiaph:LinguisticDomain ;
    rdfs:label "colpisce dominio"@it .

aiaph:BrocaAphasia aiaph:manifestsSymptom aiaph:Agrammatism , aiaph:Agraphia .
aiaph:WernickeAphasia aiaph:manifestsSymptom aiaph:Paraphasia , aiaph:Neologism , aiaph:Alexia .
aiaph:ConductionAphasia aiaph:manifestsSymptom aiaph:Paraphasia .
aiaph:AnomicAphasia aiaph:manifestsSymptom aiaph:Anomia , aiaph:Circumlocution .
aiaph:GlobalAphasia aiaph:manifestsSymptom aiaph:Agrammatism , aiaph:Alexia , aiaph:Agraphia .

aiaph:Agrammatism aiaph:affectsDomain aiaph:SyntacticMorphologicalDomain .
aiaph:Paragrammatism aiaph:affectsDomain aiaph:SyntacticMorphologicalDomain .
aiaph:Anomia aiaph:affectsDomain aiaph:SemanticLexicalDomain .
aiaph:Circumlocution aiaph:affectsDomain aiaph:SemanticLexicalDomain .
aiaph:Paraphasia aiaph:affectsDomain aiaph:PhonologicalDomain , aiaph:SemanticLexicalDomain .
aiaph:Neologism aiaph:affectsDomain aiaph:PhonologicalDomain .
aiaph:Alexia aiaph:affectsDomain aiaph:SemanticLexicalDomain .
aiaph:Agraphia aiaph:affectsDomain aiaph:SyntacticMorphologicalDomain .

#################################################################
# 4b. CO-OCCORRENZA TRA SINTOMI (proprietà simmetrica)
#
# manifestsSymptom e affectsDomain collegano i sintomi "verticalmente"
# (al tipo di afasia sopra, al dominio sotto), ma non dicono nulla sul
# fatto che certi sintomi tendano a presentarsi insieme nello stesso
# quadro clinico — un'informazione esplicita nella fonte clinica
# originaria (parafasie E neologismi nel linguaggio fluente di Wernicke;
# agrammatismo E agrafia nell'afasia di Broca; anomia E circonlocuzione
# come compenso). coOccursWithSymptom rende questo "orizzontale" esplicito
# e interrogabile, invece di lasciarlo implicito nel fatto che entrambi i
# sintomi compaiano sotto lo stesso manifestsSymptom. Dichiarata simmetrica:
# un reasoner infierisce la direzione opposta da una sola asserzione.
#################################################################

aiaph:coOccursWithSymptom a owl:ObjectProperty , owl:SymmetricProperty ;
    rdfs:domain aiaph:ClinicalSymptom ; rdfs:range aiaph:ClinicalSymptom ;
    rdfs:label "co-occorre con il sintomo"@it ;
    rdfs:comment "Simmetrica: se A coOccursWithSymptom B, un reasoner inferisce B coOccursWithSymptom A senza bisogno di asserire entrambe le direzioni a mano."@it .

aiaph:Paraphasia aiaph:coOccursWithSymptom aiaph:Neologism .
aiaph:Anomia aiaph:coOccursWithSymptom aiaph:Circumlocution .
aiaph:Agrammatism aiaph:coOccursWithSymptom aiaph:Agraphia .

#################################################################
# 5. TEST DIAGNOSTICI
#################################################################

aiaph:assessesModality a owl:ObjectProperty ;
    rdfs:domain aiaph:DiagnosticTest ; rdfs:range aiaph:CommunicationModality ;
    rdfs:label "valuta la modalità"@it .

aiaph:detectsSymptom a owl:ObjectProperty ;
    rdfs:domain aiaph:DiagnosticTest ; rdfs:range aiaph:ClinicalSymptom ;
    rdfs:label "rileva il sintomo"@it .

aiaph:BostonDiagnosticAphasiaExamination a aiaph:DiagnosticTest ;
    rdfs:label "Boston Diagnostic Aphasia Examination (BDAE)"@it ;
    aiaph:assessesModality aiaph:OralProduction , aiaph:OralComprehension , aiaph:WrittenProduction , aiaph:WrittenComprehension ;
    aiaph:detectsSymptom aiaph:Paraphasia , aiaph:Agrammatism , aiaph:Anomia .
aiaph:WesternAphasiaBattery a aiaph:DiagnosticTest ;
    rdfs:label "Western Aphasia Battery (WAB)"@it ;
    aiaph:assessesModality aiaph:OralProduction , aiaph:OralComprehension ;
    aiaph:detectsSymptom aiaph:Paraphasia , aiaph:Agrammatism , aiaph:Anomia .
aiaph:BostonNamingTest a aiaph:DiagnosticTest ;
    rdfs:label "Boston Naming Test (BNT)"@it ;
    rdfs:comment "Valuta la denominazione; usato come riferimento in Edmonds et al. per la validazione del VNeST."@it ;
    aiaph:assessesModality aiaph:OralProduction ;
    aiaph:detectsSymptom aiaph:Anomia , aiaph:Circumlocution .
aiaph:TokenTest a aiaph:DiagnosticTest ;
    rdfs:label "Token Test"@it ;
    aiaph:assessesModality aiaph:OralComprehension .
aiaph:ActionNamingTest a aiaph:DiagnosticTest ;
    rdfs:label "Action Naming Test"@it ;
    aiaph:assessesModality aiaph:OralProduction ;
    aiaph:detectsSymptom aiaph:Anomia .

#################################################################
# 6. TECNICHE DI IA (individui)
#
# aiaph:processesModality collega ogni tecnica alla modalità comunicativa
# che tratta effettivamente in ingresso o in uscita, cosicché una tecnica
# non resti un'etichetta isolata ma si agganci allo stesso sottografo di
# modalità/domini già usato per le ClinicalApplication. Lasciata
# deliberatamente assente per le tecniche realmente modalità-agnostiche
# (classificatori/regressori generici su feature tabellari o di imaging):
# collegarle avrebbe significato inventare una precisione che la fonte
# non dà, lo stesso principio di onestà già adottato altrove nel grafo.
#################################################################

aiaph:processesModality a owl:ObjectProperty ;
    rdfs:domain aiaph:AITechnique ; rdfs:range aiaph:CommunicationModality ;
    rdfs:label "elabora la modalità"@it .

aiaph:AdaptiveLearningAlgorithm a aiaph:AITechnique ;
    rdfs:label "Algoritmo di apprendimento adattivo"@it .
aiaph:AutomaticSpeechRecognition a aiaph:AITechnique ;
    rdfs:label "Riconoscimento automatico del parlato (ASR)"@it ;
    aiaph:processesModality aiaph:OralProduction .
aiaph:NaturalLanguageProcessing a aiaph:AITechnique ;
    rdfs:label "Elaborazione del linguaggio naturale (NLP)"@it ;
    aiaph:processesModality aiaph:WrittenProduction .
aiaph:LargeLanguageModelGeneration a aiaph:AITechnique ;
    rdfs:label "Generazione tramite modello linguistico di grande scala (LLM)"@it ;
    aiaph:processesModality aiaph:OralProduction , aiaph:WrittenProduction .
aiaph:DeepLearningClassifier a aiaph:AITechnique ;
    rdfs:label "Classificatore basato su deep learning"@it .
aiaph:SupportVectorMachineClassifier a aiaph:AITechnique ;
    rdfs:label "Classificatore Support Vector Machine (SVM)"@it .
aiaph:EmbodiedConversationalAvatar a aiaph:AITechnique ;
    rdfs:label "Avatar/agente conversazionale incarnato"@it ;
    aiaph:processesModality aiaph:OralComprehension , aiaph:OralProduction .
aiaph:VirtualRealityEnvironment a aiaph:AITechnique ;
    rdfs:label "Ambiente di realtà virtuale"@it ;
    aiaph:processesModality aiaph:OralComprehension , aiaph:OralProduction .
aiaph:IntracorticalBCI a aiaph:AITechnique ;
    rdfs:label "Interfaccia cervello-computer intracorticale"@it ;
    aiaph:processesModality aiaph:OralProduction .
aiaph:RealTimeUtteranceVerification a aiaph:AITechnique ;
    rdfs:label "Verifica automatica dell'enunciato in tempo reale"@it ;
    aiaph:processesModality aiaph:OralProduction .
aiaph:SupportVectorRegression a aiaph:AITechnique ;
    rdfs:label "Regressione Support Vector (SVR)"@it .
aiaph:RandomForestRegression a aiaph:AITechnique ;
    rdfs:label "Regressione Random Forest"@it .
aiaph:NonInvasiveEEGBCI a aiaph:AITechnique ;
    rdfs:label "Interfaccia cervello-computer EEG non invasiva"@it ;
    aiaph:processesModality aiaph:OralProduction .
aiaph:MultimodalNeuroimagingML a aiaph:AITechnique ;
    rdfs:label "Machine learning multimodale su neuroimmagini"@it .

#################################################################
# 7. LIVELLI DI EVIDENZA (scala a 5 punti, individui)
#################################################################

aiaph:Level1_SystematicReviewOrRCT a aiaph:EvidenceLevel ;
    rdfs:label "Livello 1 - Revisione sistematica / RCT multicentrico"@it ;
    aiaph:evidenceScore 5 .
aiaph:Level2_ControlledTrial a aiaph:EvidenceLevel ;
    rdfs:label "Livello 2 - Trial controllato/randomizzato singolo centro"@it ;
    aiaph:evidenceScore 4 .
aiaph:Level3_PilotOrSingleCase a aiaph:EvidenceLevel ;
    rdfs:label "Livello 3 - Studio pilota / caso singolo clinico"@it ;
    aiaph:evidenceScore 3 .
aiaph:Level4_ExperimentalPrototype a aiaph:EvidenceLevel ;
    rdfs:label "Livello 4 - Prototipo sperimentale / proof-of-concept"@it ;
    aiaph:evidenceScore 2 .
aiaph:Level5_InformalClinicalUse a aiaph:EvidenceLevel ;
    rdfs:label "Livello 5 - Uso clinico informale / opinione di esperti"@it ;
    aiaph:evidenceScore 1 .

[] a owl:AllDifferent ;
   owl:distinctMembers ( aiaph:Level1_SystematicReviewOrRCT aiaph:Level2_ControlledTrial
                          aiaph:Level3_PilotOrSingleCase aiaph:Level4_ExperimentalPrototype
                          aiaph:Level5_InformalClinicalUse ) .

#################################################################
# 8. CATEGORIE DI LIMITE (sottoclassi ortogonali di Limitation)
#################################################################

aiaph:DataLimitation a owl:Class ; rdfs:subClassOf aiaph:Limitation ;
    rdfs:label "Limite legato ai dati"@it ;
    rdfs:comment "Scarsità o bias nei dati di addestramento (lingue, accenti, tipi di afasia sotto-rappresentati)."@it .
aiaph:ClinicalGovernanceLimitation a owl:Class ; rdfs:subClassOf aiaph:Limitation ;
    rdfs:label "Limite di governance clinica"@it ;
    rdfs:comment "Necessità di supervisione del clinico; rischio che lo strumento sia usato senza il controllo umano previsto dal disegno originario."@it .
aiaph:GeneralizabilityLimitation a owl:Class ; rdfs:subClassOf aiaph:Limitation ;
    rdfs:label "Limite di generalizzabilità"@it ;
    rdfs:comment "Campioni piccoli, monocentrici o singolo-caso; risultati non ancora estendibili alla popolazione generale di persone con afasia."@it .
aiaph:ConstructValidityLimitation a owl:Class ; rdfs:subClassOf aiaph:Limitation ;
    rdfs:label "Limite di validità di costrutto"@it ;
    rdfs:comment "Lo strumento non misura in modo affidabile ciò che promette di misurare (es. errori di trascrizione ASR che si propagano alle feature linguistiche)."@it .
aiaph:AccessibilityLimitation a owl:Class ; rdfs:subClassOf aiaph:Limitation ;
    rdfs:label "Limite di accessibilità"@it ;
    rdfs:comment "Barriere di alfabetizzazione digitale, costo, disponibilità tecnologica per il paziente."@it .
aiaph:NosologicalBoundaryLimitation a owl:Class ; rdfs:subClassOf aiaph:Limitation ;
    rdfs:label "Limite di confine nosografico"@it ;
    rdfs:comment "Lo strumento è sviluppato per un disturbo comunicativo adiacente ma nosograficamente distinto dall'afasia (es. anartria/disartria motoria), e viene qui incluso per la sua rilevanza analitica ai confini della categoria."@it .

aiaph:limitationNote rdfs:label "nota sul limite"@it .

#################################################################
# 9. PROPRIETA' OGGETTO PRINCIPALI (dominio AITool / ClinicalApplication)
#################################################################

aiaph:isApplicationOf a owl:ObjectProperty ;
    rdfs:domain aiaph:ClinicalApplication ; rdfs:range aiaph:AITool ;
    rdfs:label "è applicazione di"@it .

aiaph:employsTechnique a owl:ObjectProperty ;
    rdfs:domain aiaph:AITool ; rdfs:range aiaph:AITechnique ;
    rdfs:label "impiega tecnica"@it .

aiaph:targetsAphasiaType a owl:ObjectProperty ;
    rdfs:domain aiaph:ClinicalApplication ; rdfs:range aiaph:AphasiaType ;
    rdfs:label "ha come target il tipo di afasia"@it .

aiaph:addressesLinguisticDomain a owl:ObjectProperty ;
    rdfs:domain aiaph:ClinicalApplication ; rdfs:range aiaph:LinguisticDomain ;
    rdfs:label "indirizza il dominio linguistico"@it .

aiaph:addressesModality a owl:ObjectProperty ;
    rdfs:domain aiaph:ClinicalApplication ; rdfs:range aiaph:CommunicationModality ;
    rdfs:label "indirizza la modalità comunicativa"@it .

aiaph:hasEvidenceLevel a owl:ObjectProperty ;
    rdfs:domain aiaph:ClinicalApplication ; rdfs:range aiaph:EvidenceLevel ;
    rdfs:label "ha livello di evidenza"@it .

aiaph:hasLimitation a owl:ObjectProperty ;
    rdfs:domain aiaph:ClinicalApplication ; rdfs:range aiaph:Limitation ;
    rdfs:label "ha limite"@it .

aiaph:evaluatedByTest a owl:ObjectProperty ;
    rdfs:domain aiaph:ClinicalApplication ; rdfs:range aiaph:DiagnosticTest ;
    rdfs:label "valutato tramite test"@it .

#################################################################
# 9b. PROPRIETA' INVERSA E PROPERTY CHAIN (navigazione diretta
# AITool -> AphasiaType attraverso la cerniera reificata)
#
# aiaph:ClinicalApplication reifica l'uso di uno strumento, quindi lo
# strumento e il tipo di afasia che tratta non sono mai connessi da una
# singola tripla, ma solo attraverso l'applicazione intermedia. Questo e'
# corretto dal punto di vista della modellazione (lo stesso AITool puo'
# generare applicazioni con target diversi), ma rende scomoda una domanda
# frequente ("quali strumenti trattano l'afasia di Broca?") sia per un
# reasoner sia per una query SPARQL a pattern fisso. Usando query a
# percorso di proprieta' (property path, operatori / e ^), introduciamo:
# (i) l'inversa dichiarata di isApplicationOf, e (ii) una proprieta' derivata definita
# come catena di proprieta' (owl:propertyChainAxiom), cosicche' il
# reasoner stesso possa materializzare il collegamento diretto, senza che
# nessuna tripla aiaph:toolTargetsAphasiaType sia asserita a mano.
#################################################################

aiaph:hasClinicalApplication a owl:ObjectProperty ;
    owl:inverseOf aiaph:isApplicationOf ;
    rdfs:domain aiaph:AITool ; rdfs:range aiaph:ClinicalApplication ;
    rdfs:label "ha applicazione clinica"@it .

aiaph:toolTargetsAphasiaType a owl:ObjectProperty ;
    rdfs:domain aiaph:AITool ; rdfs:range aiaph:AphasiaType ;
    owl:propertyChainAxiom ( aiaph:hasClinicalApplication aiaph:targetsAphasiaType ) ;
    rdfs:label "lo strumento ha come target (indirettamente) il tipo di afasia"@it ;
    rdfs:comment "Proprieta' derivata, non asserita: un reasoner la infere componendo hasClinicalApplication (inversa di isApplicationOf) con targetsAphasiaType. Permette di interrogare direttamente 'quali AITool trattano il sottotipo X' senza passare esplicitamente per la ClinicalApplication intermedia, pur mantenendo quest'ultima come unico punto dove il fatto e' davvero asserito. L'equivalente a livello di query, utilizzabile anche senza reasoner attivo, e' il property path SPARQL ^aiaph:isApplicationOf/aiaph:targetsAphasiaType (si veda sparql/cq7_tool_level_targeting.rq)."@it .

#################################################################
# 10. PROPRIETA' DATI PRINCIPALI
#################################################################

aiaph:toolName a owl:AnnotationProperty .
aiaph:developer a owl:AnnotationProperty .
aiaph:releaseYear a owl:DatatypeProperty ; rdfs:domain aiaph:AITool ; rdfs:range xsd:integer .
aiaph:toolDescription a owl:AnnotationProperty .
aiaph:sourceURL a owl:AnnotationProperty .
aiaph:icd11Code a owl:AnnotationProperty .
aiaph:icd10cmCode a owl:AnnotationProperty .
aiaph:standardsAlignmentNote a owl:AnnotationProperty .
aiaph:applicationDescription a owl:AnnotationProperty .
aiaph:evidenceScore a owl:DatatypeProperty ; rdfs:domain aiaph:EvidenceLevel ; rdfs:range xsd:integer .
aiaph:reportedMetric a owl:AnnotationProperty ;
    rdfs:comment "Una metrica quantitativa riportata in letteratura per questa applicazione (es. accuratezza, WER, dimensione campione), come stringa libera per preservarne il contesto."@it .
aiaph:limitationNote a owl:AnnotationProperty .

#################################################################
# 11. INDIVIDUI: AITool + ClinicalApplication (16 casi di studio)
#################################################################

### 1. Constant Therapy -----------------------------------------------------
aiaph:ConstantTherapy a aiaph:AITool ;
    aiaph:toolName "Constant Therapy" ;
    aiaph:developer "Constant Therapy Health, Inc. (ricerca fondativa di Swathi Kiran, Boston University)" ;
    aiaph:releaseYear "2013"^^xsd:integer ;
    aiaph:toolDescription "Piattaforma digitale terapeutica per tablet/smartphone con oltre 14 categorie e 80+ esercizi di linguaggio, parola e cognizione. Il 'NeuroPerformance Engine' (NPE), proprietario, usa AI e analisi dei dati per personalizzare in tempo reale il programma di esercizi in base ai progressi dell'utente."@it ;
    aiaph:sourceURL <https://constanttherapyhealth.com/science/> ;
    aiaph:employsTechnique aiaph:AdaptiveLearningAlgorithm .

aiaph:ca_ConstantTherapy a aiaph:TherapeuticApplication ;
    aiaph:isApplicationOf aiaph:ConstantTherapy ;
    aiaph:applicationDescription "Terapia digitale auto-somministrata ad alta intensità per l'afasia post-ictus, pensata per estendere la pratica oltre la seduta clinica tradizionale; un trial di fase II decentralizzato ha mostrato risultati statisticamente e clinicamente superiori allo standard of care."@it ;
    aiaph:targetsAphasiaType aiaph:AnomicAphasia , aiaph:BrocaAphasia ;
    aiaph:addressesLinguisticDomain aiaph:SemanticLexicalDomain ;
    aiaph:addressesModality aiaph:OralProduction , aiaph:WrittenProduction ;
    aiaph:hasEvidenceLevel aiaph:Level2_ControlledTrial ;
    aiaph:reportedMetric "800.000+ utenti; 325 milioni+ esercizi completati; trial di fase II decentralizzato più efficace dello standard of care (Kiran & Smith, 2025)" ;
    aiaph:hasLimitation aiaph:lim_ct_1 .
aiaph:lim_ct_1 a aiaph:AccessibilityLimitation ;
    aiaph:limitationNote "L'efficacia dell'autogestione digitale è condizionata da alfabetizzazione digitale e supporto tecnologico disponibile; Nichol et al. (2023) segnalano questi come barriere reali all'implementazione."@it .

### 2. iTalkBetter ------------------------------------------------------------
aiaph:ITalkBetter a aiaph:AITool ;
    aiaph:toolName "iTalkBetter" ;
    aiaph:developer "University College London (UCL)" ;
    aiaph:releaseYear "2020"^^xsd:integer ;
    aiaph:toolDescription "App di terapia gamificata auto-condotta per la produzione del linguaggio, dotata di un sistema di verifica automatica dell'enunciato in tempo reale che guida l'algoritmo di terapia adattiva."@it ;
    aiaph:sourceURL <https://www.ncbi.nlm.nih.gov/pmc/articles/PMC11056404/> ;
    aiaph:employsTechnique aiaph:RealTimeUtteranceVerification , aiaph:AdaptiveLearningAlgorithm .

aiaph:ca_ITalkBetter a aiaph:TherapeuticApplication ;
    aiaph:isApplicationOf aiaph:ITalkBetter ;
    aiaph:applicationDescription "Terapia di denominazione a confronto (confrontation naming) per il recupero lessicale in afasia cronica, verificata in un trial clinico randomizzato item-per-item di fase II (27 partecipanti, UCL, 2020-2022) con esiti comportamentali e di risonanza magnetica strutturale/funzionale."@it ;
    aiaph:targetsAphasiaType aiaph:AnomicAphasia , aiaph:BrocaAphasia ;
    aiaph:addressesLinguisticDomain aiaph:SemanticLexicalDomain ;
    aiaph:addressesModality aiaph:OralProduction ;
    aiaph:hasEvidenceLevel aiaph:Level2_ControlledTrial ;
    aiaph:reportedMetric "n=27; trial randomizzato a livello di item; blocco di terapia di 6 settimane; cambiamenti osservabili in struttura/funzione cerebrale" ;
    aiaph:hasLimitation aiaph:lim_itb_1 .
aiaph:lim_itb_1 a aiaph:GeneralizabilityLimitation ;
    aiaph:limitationNote "Campione monocentrico di 27 persone; la risposta alla terapia risulta variabile tra individui e le regioni cerebrali chiave per l'impegno terapeutico non sono ancora del tutto identificate."@it .

